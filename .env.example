# OpenWeather API Key (Get from https://openweathermap.org/api)
VITE_OPENWEATHER_API_KEY=your_key_here

# Unsplash API Access Key (Get from https://unsplash.com/developers)
VITE_UNSPLASH_ACCESS_KEY=your_key_here

# Google Gemini API Key for Vercel Serverless Function (Server-side)
GEMINI_API_KEY=your_key_here

# Optional: Google Gemini API Key for local development direct fallback
VITE_GEMINI_API_KEY=your_key_here